{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.fusionkit.app",
  "asar": true,
  "directories": {
    "buildResources": "build",
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraResources": [
    {
      "from": "build/local-subtitle-resources/local-subtitle",
      "to": "local-subtitle",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/subtitle-studio-resources/transcription",
      "to": "subtitle-studio/transcription",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/external-agent",
      "to": "external-agent",
      "filter": [
        "**/*"
      ]
    }
  ],
  "beforePack": "scripts/packaging/subtitle-studio-before-pack.cjs",
  "mac": {
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "icon": "build/FusionKit.icns",
    "signIgnore": [
      "Contents/Resources/local-subtitle/",
      "Contents/Resources/subtitle-studio/transcription/"
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/FusionKit.ico",
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "extraResources": [
      {
        "from": "build/vc-redist",
        "to": "vc-redist",
        "filter": [
          "vc_redist.x64.exe",
          "vc-redist.json"
        ]
      }
    ]
  },
  "nsis": {
    "include": "build/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/FusionKit.ico",
    "uninstallerIcon": "build/FusionKit.ico",
    "installerHeaderIcon": "build/FusionKit.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FusionKit"
  },
  "dmg": {
    "icon": "build/FusionKit.icns",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 270,
        "y": 80,
        "type": "file",
        "path": "build/dmg/打不开请看这里.html",
        "name": "打不开请看这里 Can't open.html"
      }
    ]
  },
  "publish": {
    "provider": "github",
    "channel": "latest",
    "owner": "QiuYeDx",
    "repo": "FusionKit",
    "releaseType": "release"
  }
}
