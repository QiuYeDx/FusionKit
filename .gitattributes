# Subtitle Studio records and copied/audited text are verified as exact LF bytes.
# Keep checkout bytes stable under core.autocrlf without normalizing in verifiers.
/resources/subtitle-studio/provenance/*.json text eol=lf
/electron/main/subtitle-studio/transcription/native/*.ts text eol=lf
/electron/main/subtitle-studio/transcription/transcript-executor.ts text eol=lf
/src/subtitle-studio/transcription/*.ts text eol=lf
/test/subtitle-studio/transcription/*.ts text eol=lf
/test/subtitle-studio/transcription/fixtures/poc/*.json text eol=lf
/scripts/subtitle-studio/transcription/runtime/*.mjs text eol=lf
/scripts/subtitle-studio/transcription/overwrite-native/*.mjs text eol=lf
/native/subtitle-studio-overwrite/*.md text eol=lf
/native/subtitle-studio-overwrite/*.gyp text eol=lf
/native/subtitle-studio-overwrite/src/*.cc text eol=lf
/resources/subtitle-studio/transcription/manifests/*.json text eol=lf
/resources/subtitle-studio/transcription/licenses/*.json text eol=lf
/resources/subtitle-studio/transcription/licenses/*.md text eol=lf
/resources/subtitle-studio/transcription/licenses/*.txt text eol=lf

# Neutral resource extraction outputs are verified as exact LF bytes.
/electron/main/speech-resources/engine/*.ts text eol=lf
/electron/main/speech-resources/catalog.ts text eol=lf
/src/speech-resources/contracts.ts text eol=lf
/src/speech-resources/schemas.ts text eol=lf
/test/speech-resources/engine/*.ts text eol=lf
/resources/speech-resources/manifests/*.json text eol=lf
/resources/speech-resources/provenance/*.json text eol=lf
# Historical migration receipts preserve their initial, audited checkout bytes.
/resources/speech-resources/migration/legacy/*.json text eol=crlf
/resources/speech-resources/migration/studio/*.json text eol=lf
